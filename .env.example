DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-this-for-local-use
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_ENGINE=django.db.backends.sqlite3
DB_NAME=conect_services
DB_USER=conect_services
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
REDIS_URL=redis://localhost:6379/0

# Email notifications use the console backend locally. Configure SMTP for
# production and replace these example values with secrets from your provider.
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-this
EMAIL_HOST_PASSWORD=replace-this
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Conect Services <noreply@example.com>
WEB_APP_URL=http://localhost:3000

# Private verification-document storage for production (S3-compatible).
# Keep the bucket private; documents are only downloadable by administrators.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=

# Configure these when deploying behind HTTPS.
CSRF_TRUSTED_ORIGINS=https://example.com
